# Empty = relative URL → frontend calls its own origin (/api/...).
# Vercel rewrites /api/* to the serverless function (api/index.js).
# This eliminates the dependency on Render.com's free-tier sleep delays.
# To override for a specific host, set REACT_APP_API_BASE in that host's
# environment-variable dashboard (takes precedence over this file at build time).
REACT_APP_API_BASE=
DISABLE_ESLINT_PLUGIN=true
CI=false
